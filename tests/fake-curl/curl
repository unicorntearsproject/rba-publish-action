#!/usr/bin/env bash
# Test stand-in for curl (tests/test_publish_offline.sh, tests 23-24). It
# behaves like ubuntu-22.04's curl 7.81: no -w '%header{…}', which it prints
# literally, as the real one does.
#   FAKE_CURL  s3-403 | s3-404 | waf-403 | ok | 503 | timeout   (GET, test 23)
#              head-ok | head-nolength | head-404 | head-fail   (-I, test 24)
#   FAKE_CURL_BODY  the body for "ok" (a manifest); FAKE_CURL_LEN for head-ok
#   FAKE_CURL_LOG   if set, each call appends "ua=<its -A value>" there
set -euo pipefail
out=/dev/null hdr=/dev/null fmt="" head=0 ua="(none)"
while (($#)); do
  case $1 in
    --version) echo "curl 7.81.0 (x86_64-pc-linux-gnu) libcurl/7.81.0 (fake)"; exit 0 ;;
    -o) out=$2; shift ;;
    -D) hdr=$2; shift ;;
    -w) fmt=$2; shift ;;
    -A|--user-agent) ua=$2; shift ;;
    -I|--head) head=1 ;;
    -sSI|-sI) head=1 ;;
    --connect-timeout|--max-time) shift ;;
  esac
  shift
done
[[ -z ${FAKE_CURL_LOG:-} ]] || echo "ua=$ua" >>"$FAKE_CURL_LOG"
if ((head)); then
  # Headers to stdout (no -o), then what an old curl does with -w: %{…}
  # variables expand, %header{…} is printed as is.
  case ${FAKE_CURL:?} in
    head-ok) printf 'HTTP/2 200\r\ncontent-type: application/octet-stream\r\ncontent-length: %s\r\n\r\n' "${FAKE_CURL_LEN:?}" ;;
    head-nolength) printf 'HTTP/2 200\r\ncontent-type: text/plain\r\n\r\n' ;;
    head-404) printf 'HTTP/2 404\r\ncontent-type: application/xml\r\n\r\n' ;;
    head-fail) echo "curl: (6) Could not resolve host" >&2; exit 6 ;;
  esac
  [[ -z $fmt ]] || printf '%s' "${fmt//\%\{http_code\}/200}"
  exit 0
fi
respond() { # code server content-type body
  printf 'HTTP/2 %s\r\nserver: %s\r\ncontent-type: %s\r\n\r\n' "$1" "$2" "$3" >"$hdr"
  printf '%s' "$4" >"$out"
  [[ $fmt == *http_code* ]] && printf '%s' "$1"
  return 0
}
case ${FAKE_CURL:?} in
  s3-403) respond 403 AmazonS3 application/xml '<?xml version="1.0" encoding="UTF-8"?>
<Error><Code>AccessDenied</Code><Message>Access Denied</Message></Error>' ;;
  s3-404) respond 404 AmazonS3 application/xml '<Error><Code>NoSuchKey</Code></Error>' ;;
  waf-403) respond 403 CloudFront text/html '<html><body><h1>403 ERROR</h1>Request blocked.</body></html>' ;;
  ok) respond 200 AmazonS3 application/json "$(cat "${FAKE_CURL_BODY:?}")" ;;
  503) respond 503 CloudFront text/html '<html>503 Service Unavailable</html>' ;;
  timeout) echo "curl: (28) Operation timed out after 120000 milliseconds" >&2; exit 28 ;;
esac
